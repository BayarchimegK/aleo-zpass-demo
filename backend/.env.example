# Copy this file to .env (do NOT commit secrets)
# Database
DATABASE_URL=postgresql://admin:secret@192.168.0.14:5432/dbname

# Remote Leo host (IP or hostname). If empty, local `leo` will be used.
LEO_REMOTE_HOST=192.168.0.14
LEO_REMOTE_USER=root

# Authentication for SSH: prefer a private key; fallback to password (less secure).
# Use one of the following (do NOT set both unless you know what you're doing).
LEO_REMOTE_PRIVATE_KEY=C:\path\to\id_rsa
# If you must use a password, set it in your local .env (DO NOT commit).
LEO_REMOTE_PASSWORD=kbi!1q2w3e4r

# Local leo path (used when not using remote host)
LEO_PATH=/root/aleo-zpass-demo/leo

# Server
PORT=4000
NODE_ENV=development
